namespace Magpie {
    runtimeclass ScalingModeItem : Windows.UI.Xaml.Data.INotifyPropertyChanged {
        void RenameFlyout_Opening();
        void RenameTextBox_KeyDown(Object sender, Windows.UI.Xaml.Input.KeyRoutedEventArgs args);
        void RenameButton_Click();

        Boolean IsInitialExpanded { get; };

        String Name;
        String Description { get; };

        Boolean HasUnkownEffects { get; };
        Boolean HasNameConflict { get; };
        IObservableVector<IInspectable> Effects { get; };

        String RenameText;
        String RenameProblem { get; };
        Boolean HasRenameProblem { get; };
        Int32 RenameTextBoxSelectionStart { get; };
        Boolean IsRenameButtonEnabled { get; };

        Boolean CanDrag { get; };
        void Duplicate();

        void Remove();
        IVector<IInspectable> LinkedProfiles { get; };
        Boolean IsInUse { get; };

        Boolean CanReorderEffects { get; };
        IObservableVector<String> HdrInputChoices { get; };
        IObservableVector<String> HdrOutputChoices { get; };
        IObservableVector<String> HdrManualCaptureChoices { get; };
        Int32 HdrManualCaptureIndex;
        Boolean IsHdrManual { get; };
        Int32 HdrInputIndex;
        Int32 HdrOutputIndex;
        Boolean IsHdrManaged { get; };
        Boolean CanEditHdr { get; };
        Boolean HasHdrInputParameters { get; };
        Boolean HasHdrOutputParameters { get; };
        EffectParametersViewModel HdrInputParameters { get; };
        EffectParametersViewModel HdrOutputParameters { get; };
        String HdrSummary { get; };
        String HdrOutputDescription { get; };
        String HdrProblem { get; };
        Boolean HasHdrProblem { get; };
    }
}
